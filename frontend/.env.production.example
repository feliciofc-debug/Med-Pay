# Variáveis de ambiente do frontend em produção (Vercel)
# ============================================================================
# No Vercel, vá em: Project Settings → Environment Variables
# e adicione VITE_API_URL apontando para o backend no Render.
#
# Não cometa o `.env.production` no git — só este template.
# ============================================================================

VITE_API_URL=https://medpag-api.onrender.com

# Modo demo: deixe sempre false em produção real (true só pra demos sem backend)
VITE_DEMO_MODE=false
