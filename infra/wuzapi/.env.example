# ============================================================
# Wuzapi — variáveis de ambiente
# Copie esse arquivo pra .env (não commitado) na sua VPS Contabo
# e troque os valores em ALL_CAPS por valores reais.
# ============================================================

# Postgres do Wuzapi (independente do banco do Med-Pag)
WUZAPI_DB_NAME=wuzapi_db
WUZAPI_DB_USER=wuzapi_user
WUZAPI_DB_PASSWORD=TROQUE_AQUI_senha_forte

# Token de admin (usado pelo Med-Pag pra criar instâncias)
# Gere um aleatório de 32+ chars: openssl rand -hex 32
WUZAPI_ADMIN_TOKEN=TROQUE_AQUI_token_admin_32_chars

# Chaves internas do Wuzapi (32 chars cada). Não importa serem
# imutáveis depois de gerar (sessão depende delas pra decriptar).
# Gere: openssl rand -hex 16
WUZAPI_ENCRYPTION_KEY=TROQUE_AQUI_chave_de_criptografia32
WUZAPI_HMAC_KEY=TROQUE_AQUI_chave_hmac_de_32_chars__

# Porta exposta na VPS (cuide do firewall)
WUZAPI_PORT=8080
