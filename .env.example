# =========================================================================
# MedPag — Variáveis de Ambiente
# =========================================================================
# Copie este arquivo para `.env` e gere chaves NOVAS antes de rodar.
#
# Para gerar as chaves, rode:
#     python scripts/gerar_chaves.py
# (script presente no repositório, não precisa de dependências externas)
# =========================================================================

# Banco de dados
POSTGRES_USER=medpag
POSTGRES_PASSWORD=medpag_dev_change_in_prod
POSTGRES_DB=medpag
DATABASE_URL=postgresql+asyncpg://medpag:medpag_dev_change_in_prod@localhost:5432/medpag

# Redis
REDIS_URL=redis://localhost:6379/0

# Segurança - GERE NOVAS CHAVES EM PRODUÇÃO!
# Para SECRET_KEY (assinatura JWT, mínimo 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_secret_at_least_32_chars_long_change_me_in_production

# Para ENCRYPTION_KEY (criptografia Fernet de CPF/conta, EXATO 44 chars base64):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GERAR_COM_O_COMANDO_ACIMA_ANTES_DE_RODAR

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin inicial (usado pelo `python -m app.scripts.create_admin`)
ADMIN_EMAIL=admin@medpag.local
ADMIN_NOME=Administrador
# ADMIN_SENHA=     # se vazio, gera senha aleatória e imprime

# Seed de demonstração (Hospital Santa Casa, Clínica Vida Nova, usuário Thiago)
# true só no primeiro boot em produção; depois pode deixar false
SEED_DEMO=false
# THIAGO_SENHA=    # se vazio, usa senha padrão 'thiago123' (trocar em prod)

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# =========================================================================
# PRODUÇÃO (Render + Vercel) — apenas referência, NÃO usar essas URLs em dev
# =========================================================================
# DATABASE_URL=postgres://...                  (vem do Render Postgres)
# REDIS_URL=rediss://...                       (vem do Render Key Value)
# ENVIRONMENT=production
# CORS_ORIGINS=https://medpag.vercel.app
# VITE_API_URL=https://medpag-api.onrender.com
